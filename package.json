{
  "name": "koh-claude",
  "displayName": "Koh-Claude",
  "description": "Tableau de bord des sessions Claude Code",
  "version": "0.1.0",
  "publisher": "tjacquin42",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/tjacquin42/koh-claude.git" },
  "bugs": { "url": "https://github.com/tjacquin42/koh-claude/issues" },
  "homepage": "https://github.com/tjacquin42/koh-claude#readme",
  "engines": { "vscode": "^1.94.0", "node": ">=22" },
  "categories": ["Other"],
  "main": "./out/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "koh-claude", "title": "Koh-Claude", "icon": "resources/island.svg" }
      ]
    },
    "views": {
      "koh-claude": [
        { "id": "kohClaude.sessions", "name": "Sessions", "icon": "resources/island.svg" }
      ]
    },
    "commands": [
      { "command": "kohClaude.refresh", "title": "Rafraîchir", "category": "Koh-Claude", "icon": "$(refresh)" },
      { "command": "kohClaude.focusSession", "title": "Aller à la session", "category": "Koh-Claude" },
      { "command": "kohClaude.installHooks", "title": "Installer les hooks", "category": "Koh-Claude" },
      { "command": "kohClaude.uninstallHooks", "title": "Désinstaller les hooks", "category": "Koh-Claude" },
      { "command": "kohClaude.newGroup", "title": "Créer un dossier", "category": "Koh-Claude", "icon": "$(new-folder)" },
      { "command": "kohClaude.renameGroup", "title": "Renommer le dossier", "category": "Koh-Claude" },
      { "command": "kohClaude.colorGroup", "title": "Couleur du dossier", "category": "Koh-Claude" },
      { "command": "kohClaude.deleteGroup", "title": "Supprimer le dossier", "category": "Koh-Claude" }
    ],
    "menus": {
      "view/title": [
        { "command": "kohClaude.refresh", "when": "view == kohClaude.sessions", "group": "navigation" },
        { "command": "kohClaude.newGroup", "when": "view == kohClaude.sessions", "group": "navigation" }
      ],
      "view/item/context": [
        { "command": "kohClaude.renameGroup", "when": "view == kohClaude.sessions && viewItem == group" },
        { "command": "kohClaude.colorGroup", "when": "view == kohClaude.sessions && viewItem == group" },
        { "command": "kohClaude.deleteGroup", "when": "view == kohClaude.sessions && viewItem == group" }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/stamp-build.cjs && tsc -p .",
    "watch": "tsc -w -p .",
    "test": "vitest run",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.94.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
