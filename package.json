{
  "name": "koh-vibe",
  "displayName": "Koh-Vibe",
  "description": "Tableau de bord des sessions Claude Code",
  "version": "0.1.0",
  "publisher": "tjacquin42",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/tjacquin42/koh-vibe.git" },
  "bugs": { "url": "https://github.com/tjacquin42/koh-vibe/issues" },
  "homepage": "https://github.com/tjacquin42/koh-vibe#readme",
  "engines": { "vscode": "^1.94.0", "node": ">=22" },
  "categories": ["Other"],
  "main": "./out/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "koh-vibe", "title": "Koh-Vibe", "icon": "resources/island.svg" }
      ]
    },
    "views": {
      "koh-vibe": [
        { "id": "kohVibe.sessions", "name": "Sessions", "icon": "resources/island.svg" },
        { "id": "kohVibe.settings", "name": "Réglages", "icon": "resources/island.svg" }
      ]
    },
    "commands": [
      { "command": "kohVibe.refresh", "title": "Rafraîchir", "category": "Koh-Vibe", "icon": "$(refresh)" },
      { "command": "kohVibe.focusSession", "title": "Aller à la session", "category": "Koh-Vibe" },
      { "command": "kohVibe.installHooks", "title": "Installer les hooks", "category": "Koh-Vibe" },
      { "command": "kohVibe.uninstallHooks", "title": "Désinstaller les hooks", "category": "Koh-Vibe" },
      { "command": "kohVibe.newGroup", "title": "Créer un dossier", "category": "Koh-Vibe", "icon": "$(new-folder)" },
      { "command": "kohVibe.renameGroup", "title": "Renommer le dossier", "category": "Koh-Vibe" },
      { "command": "kohVibe.colorGroup", "title": "Couleur du dossier", "category": "Koh-Vibe" },
      { "command": "kohVibe.deleteGroup", "title": "Supprimer le dossier", "category": "Koh-Vibe" },
      { "command": "kohVibe.chooseSound", "title": "Son d'un événement", "category": "Koh-Vibe" },
      { "command": "kohVibe.chooseVolume", "title": "Volume des carillons", "category": "Koh-Vibe" },
      { "command": "kohVibe.refreshUsage", "title": "Rafraîchir la consommation", "category": "Koh-Vibe" }
    ],
    "configuration": {
      "title": "Koh-Vibe",
      "properties": {
        "kohVibe.sound.waiting": {
          "type": "string",
          "default": "",
          "description": "Son joué quand une session se met à attendre ta réponse. Vide = aucun son. Nom d'un fichier de /System/Library/Sounds ou de ~/Library/Sounds, sans extension."
        },
        "kohVibe.sound.done": {
          "type": "string",
          "default": "",
          "description": "Son joué quand une session vient de finir. Vide = aucun son."
        },
        "kohVibe.sound.volume": {
          "type": "number",
          "default": 0.5,
          "minimum": 0,
          "maximum": 1,
          "description": "Volume des carillons, de 0 à 1."
        }
      }
    },
    "menus": {
      "view/title": [
        { "command": "kohVibe.refresh", "when": "view == kohVibe.sessions", "group": "navigation" },
        { "command": "kohVibe.newGroup", "when": "view == kohVibe.sessions", "group": "navigation" }
      ],
      "view/item/context": [
        { "command": "kohVibe.renameGroup", "when": "view == kohVibe.sessions && viewItem == group" },
        { "command": "kohVibe.colorGroup", "when": "view == kohVibe.sessions && viewItem == group" },
        { "command": "kohVibe.deleteGroup", "when": "view == kohVibe.sessions && viewItem == group" }
      ]
    }
  },
  "scripts": {
    "build": "node scripts/stamp-build.cjs && tsc -p .",
    "watch": "tsc -w -p .",
    "test": "vitest run",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.94.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
