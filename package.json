{
  "name": "koh-claude",
  "displayName": "Koh-Claude",
  "description": "Tableau de bord des sessions Claude Code",
  "version": "0.1.0",
  "publisher": "tjacquin42",
  "private": true,
  "license": "UNLICENSED",
  "engines": { "vscode": "^1.94.0", "node": ">=22" },
  "categories": ["Other"],
  "main": "./out/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        { "id": "koh-claude", "title": "Koh-Claude", "icon": "resources/island.svg" }
      ]
    },
    "views": {
      "koh-claude": [
        { "id": "kohClaude.sessions", "name": "Sessions", "icon": "resources/island.svg" }
      ]
    },
    "commands": [
      { "command": "kohClaude.refresh", "title": "Koh-Claude : rafraîchir", "icon": "$(refresh)" },
      { "command": "kohClaude.focusSession", "title": "Koh-Claude : aller à la session" },
      { "command": "kohClaude.installHooks", "title": "Koh-Claude : installer les hooks" },
      { "command": "kohClaude.uninstallHooks", "title": "Koh-Claude : désinstaller les hooks" },
      { "command": "kohClaude.newGroup", "title": "Koh-Claude : créer un dossier", "icon": "$(new-folder)" },
      { "command": "kohClaude.renameGroup", "title": "Koh-Claude : renommer le dossier" },
      { "command": "kohClaude.deleteGroup", "title": "Koh-Claude : supprimer le dossier" }
    ],
    "menus": {
      "view/title": [
        { "command": "kohClaude.refresh", "when": "view == kohClaude.sessions", "group": "navigation" },
        { "command": "kohClaude.newGroup", "when": "view == kohClaude.sessions", "group": "navigation" }
      ],
      "view/item/context": [
        { "command": "kohClaude.renameGroup", "when": "view == kohClaude.sessions && viewItem == group" },
        { "command": "kohClaude.deleteGroup", "when": "view == kohClaude.sessions && viewItem == group" }
      ]
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -w -p .",
    "test": "vitest run",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.94.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
